{
  "name": "@tkflyc/ai-cli-mcp",
  "version": "7.0.0",
  "description": "Run Claude, Codex, Grok, Antigravity (agy), and any third-party OpenAI-compatible API through MCP with background jobs. Self-maintained, registry-based architecture.",
  "license": "Apache-2.0",
  "author": "moerasermax",
  "homepage": "https://github.com/moerasermax/tkflyc-ai-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moerasermax/tkflyc-ai-cli.git"
  },
  "bugs": {
    "url": "https://github.com/moerasermax/tkflyc-ai-cli/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "codex",
    "grok",
    "ai-agent",
    "cli",
    "background-jobs",
    "circuit-breaker",
    "openai-compatible"
  ],
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "ai-cli": "dist/bin/ai-cli.js",
    "ai-cli-mcp": "dist/bin/ai-cli-mcp.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "README.md",
    "README.zh-TW.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "mcp": "node dist/bin/ai-cli-mcp.js",
    "cli": "node dist/bin/ai-cli.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node tools/run-tests.mjs",
    "verify:restart-recovery": "node tools/acceptance/restart-recovery.mjs",
    "verify:worker-identity": "node tools/acceptance/worker-identity.mjs",
    "verify:strict-behaviour": "node tests/verify-strict-behaviour.mjs",
    "release:check": "node tools/verify-release.mjs",
    "prepublishOnly": "node tools/verify-release.mjs"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
